[Unit]
Description=Relay Job Application Agent
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/relay
Environment="PATH=/home/ubuntu/relay/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="DATABASE_URL=sqlite+aiosqlite:///data/job_agent.db"
EnvironmentFile=/home/ubuntu/relay/.env
ExecStart=/home/ubuntu/relay/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
